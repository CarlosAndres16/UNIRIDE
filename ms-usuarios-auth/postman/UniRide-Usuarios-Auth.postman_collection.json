{
  "info": {
    "_postman_id": "a0d5d12c-53b1-478d-81ef-ac8a21f94ef0",
    "name": "UniRide | ms-usuarios-auth",
    "description": "Contrato de cinco endpoints. Ejecutar en orden con entorno local y password configurado solo como valor local. La primera solicitud genera un correo único. No incluye secretos de SQL Server ni JWT_SECRET.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set(\"correlationId\", pm.variables.replaceIn(\"{{$guid}}\"));",
          "if (!pm.environment.get(\"password\")) { throw new Error(\"Configura password (mínimo 8 caracteres) como valor local del entorno.\"); }",
          "pm.variables.set(\"passwordJson\", JSON.stringify(pm.environment.get(\"password\")));",
          "if (pm.info.requestName === \"01. Registrar conductor\") { pm.environment.set(\"correo\", \"conductor.\" + Date.now() + \".\" + pm.variables.replaceIn(\"{{$guid}}\").slice(0, 8) + \"@example.com\"); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Devuelve el correlation ID de la solicitud\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.variables.get(\"correlationId\")));",
          "const responseBody = pm.response.json();",
          "pm.test(\"No expone campos privados\", () => { [\"password\", \"passwordHash\", \"password_hash\"].forEach(key => pm.expect(responseBody).not.to.have.property(key)); const password = pm.environment.get(\"password\"); if (password) { pm.expect(pm.response.text()).not.to.include(password); } });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Flujo contractual",
      "item": [
        {
          "name": "01. Registrar conductor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Apache\",\n  \"correo\": \"{{correo}}\",\n  \"password\": {{passwordJson}},\n  \"telefono\": \"3001234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Objeto Conductor exacto\", () => pm.expect(Object.keys(body).sort()).to.eql([\"activo\", \"conductorId\", \"correo\", \"nombre\", \"telefono\"]));",
                  "pm.environment.set(\"conductorId\", String(body.conductorId));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": {{passwordJson}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Token Bearer y vigencia\", () => { pm.expect(body.tokenType).to.eql(\"Bearer\"); pm.expect(body.expiresIn).to.be.a(\"number\").above(0); pm.expect(body.conductorId).to.eql(Number(pm.environment.get(\"conductorId\"))); });",
                  "pm.environment.set(\"accessToken\", body.accessToken);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03. Consultar autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Identidad JWT\", () => { pm.expect(pm.response.json().conductorId).to.eql(Number(pm.environment.get(\"conductorId\"))); });"
                ]
              }
            }
          ],
          "response": []
        },
